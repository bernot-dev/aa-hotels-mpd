{
	"manifest_version": 3,
	"name": "AA Hotels MPD",
	"version": "1.1.0",
	"description": "Calcualte miles per dollar on AA Hotels",
	  "icons": {
		"16": "images/icon-16.png",
		"32": "images/icon-32.png",
		"48": "images/icon-48.png",
		"128": "images/icon-128.png"
	},
	"content_scripts": [
		{
			"js": ["dist/content.js"],
			"matches": [
				"https://www.aadvantagehotels.com/",
				"https://www.aadvantagehotels.com/details?*",
				"https://www.aadvantagehotels.com/search?*"
			],
			"run_at": "document_end"
		}
	]
}
