{
  "manifest_version": 3,
  "name": "AA Hotels MPD",
  "version": "1.4.0",
  "options_page": "options.html",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.aadvantagehotels.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "description": "Calculate miles per dollar on AA Hotels",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "js": [
        "dist/interceptor.js"
      ],
      "matches": [
        "https://www.aadvantagehotels.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "dist/content.js"
      ],
      "matches": [
        "https://www.aadvantagehotels.com/*"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/interceptor.js"
      ],
      "matches": [
        "https://www.aadvantagehotels.com/*"
      ]
    }
  ]
}
