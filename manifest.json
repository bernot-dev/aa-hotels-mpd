{
  "manifest_version": 3,
  "name": "AA Hotels MPD",
  "version": "2.0.0",
  "options_page": "options.html",
  "action": {
    "default_title": "AA Hotels MPD",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://search.aadvantagehotels.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "description": "Calculate miles per dollar on AA Hotels",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "js": [
        "dist/interceptor.js"
      ],
      "matches": [
        "https://search.aadvantagehotels.com/*"
      ],
      "exclude_matches": [
        "https://search.aadvantagehotels.com/checkout*",
        "https://search.aadvantagehotels.com/book*",
        "https://search.aadvantagehotels.com/booking*",
        "https://search.aadvantagehotels.com/payment*",
        "https://search.aadvantagehotels.com/accom/checkout*",
        "https://search.aadvantagehotels.com/accom/book*",
        "https://search.aadvantagehotels.com/accom/booking*",
        "https://search.aadvantagehotels.com/*checkout*",
        "https://search.aadvantagehotels.com/*payment*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "dist/content.js"
      ],
      "matches": [
        "https://search.aadvantagehotels.com/*"
      ],
      "exclude_matches": [
        "https://search.aadvantagehotels.com/checkout*",
        "https://search.aadvantagehotels.com/book*",
        "https://search.aadvantagehotels.com/booking*",
        "https://search.aadvantagehotels.com/payment*",
        "https://search.aadvantagehotels.com/accom/checkout*",
        "https://search.aadvantagehotels.com/accom/book*",
        "https://search.aadvantagehotels.com/accom/booking*",
        "https://search.aadvantagehotels.com/*checkout*",
        "https://search.aadvantagehotels.com/*payment*"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/interceptor.js"
      ],
      "matches": [
        "https://search.aadvantagehotels.com/*"
      ]
    },
    {
      "resources": [
        "images/icon-16.png",
        "images/icon-32.png",
        "images/icon-48.png",
        "images/icon-128.png"
      ],
      "matches": [
        "https://search.aadvantagehotels.com/*",
        "*://www.aadvantagehotels.com/*"
      ]
    }
  ]
}
